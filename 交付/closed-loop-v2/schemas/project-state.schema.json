{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectStateTransition",
  "type": "object",
  "required": ["task_id", "from", "to", "actor", "reason", "evidence",
               "timestamp"],
  "properties": {
    "task_id": {"type": "string"},
    "from": {
      "type": "string",
      "enum": ["TASK_READY", "WORKER_RUNNING", "AUDIT_PENDING",
               "PLANNER_PENDING", "LOCAL_FIX_PENDING", "WORKER_RETRYING",
               "REPLAN_PENDING", "GATE_PENDING", "DONE", "HUMAN", "FAILED"]
    },
    "to": {
      "type": "string",
      "enum": ["TASK_READY", "WORKER_RUNNING", "AUDIT_PENDING",
               "PLANNER_PENDING", "LOCAL_FIX_PENDING", "WORKER_RETRYING",
               "REPLAN_PENDING", "GATE_PENDING", "DONE", "HUMAN", "FAILED"]
    },
    "actor": {"type": "string"},
    "reason": {"type": "string"},
    "evidence": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
