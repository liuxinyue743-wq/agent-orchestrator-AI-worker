{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionPlan",
  "type": "object",
  "required": ["mission_id", "subtasks"],
  "properties": {
    "mission_id": {"type": "string"},
    "strategy": {"type": "string"},
    "subtasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["subtask_id", "objective", "allowed_paths",
                     "acceptance_criteria"],
        "properties": {
          "subtask_id": {"type": "string"},
          "objective": {"type": "string"},
          "allowed_paths": {"type": "array",
                            "items": {"type": "string"},
                            "minItems": 1},
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "properties": {
                "id": {"type": "string"},
                "description": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "dependencies": {"type": "array",
                           "items": {"type": "string"}},
          "gate_commands": {"type": "array",
                            "items": {"type": "string"},
                            "description": "Isolated-worker gate commands scoped to this subtask's own files (workers can't see sibling work)."}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
