{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerifierResult",
  "type": "object",
  "required": ["verify_id", "task_id", "verdict", "ac_checks", "anti_gaming"],
  "properties": {
    "verify_id": {"type": "string"},
    "task_id": {"type": "string"},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL"]},
    "ac_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac_id", "verdict"],
        "properties": {
          "ac_id": {"type": "string"},
          "verdict": {"type": "string",
                      "enum": ["PASS", "FAIL", "UNVERIFIABLE"]},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "anti_gaming": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac_id", "verdict"],
        "properties": {
          "ac_id": {"type": "string"},
          "verdict": {"type": "string",
                      "enum": ["PASS", "FAIL", "UNVERIFIABLE"]},
          "note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "summary": {"type": "string"}
  },
  "additionalProperties": true
}
